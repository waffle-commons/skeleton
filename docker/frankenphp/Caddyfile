{
# Active le mode Worker de FrankenPHP (Performance X10). La directive vient de
# FRANKENPHP_CONFIG (Dockerfile : « worker ./public/index.php »), comme dans le
# Caddyfile officiel de FrankenPHP ; un simple `frankenphp` l'ignorerait. Si la
# variable est vide, FrankenPHP reste en mode classique et le runtime Waffle
# traite alors une requête par exécution.
    frankenphp {
        {$FRANKENPHP_CONFIG}
    }
    order php_server before file_server

    # Arrêt gracieux (OPS-02, RFC-023 §3.4 et §5.1). À SIGTERM, Caddy ferme ses ports
    # et laisse les requêtes en cours finir pendant `grace_period`. La bascule de /readyz
    # se fait AVANT, dans le hook preStop du pod (Kubernetes) :
    #   lifecycle.preStop.exec.command: ["sh", "-c", "touch /tmp/waffle-draining && sleep 5"]
    # terminationGracePeriodSeconds doit dépasser le sommeil du preStop + grace_period.
    # (Pas de `shutdown_delay` : FrankenPHP s'arrête dès SIGTERM, chaque requête PHP
    # pendant ce délai répondrait 500 — mesuré sur FrankenPHP 1.12.7.)
    grace_period {$CADDY_GRACE_PERIOD:25s}
}

# Définition du serveur (HTTP/HTTPS géré automatiquement)
{$SERVER_NAME:localhost} {
    root * public/
    encode zstd gzip

    php_server {
        # Configure le point d'entrée pour les URLs qui ne sont pas des fichiers
        resolve_root_symlink
    }

    # Servir les fichiers statiques (images, css, js)
    file_server
}