# Misc
/**/.DS_Store

# IDEs
.idea/
.vscode/
.idx/

# Framework dev specific
/.env
/.env.local
/.env.*.local

# Tools
.claude/
.devtool/
.opencode/
.project-memory/
.tooling-venv/
graphify-out/
scripts/

# Vendors
vendor/

# Cache
var/

# Composer
# The lock is deliberately NOT shipped: this is the `composer create-project`
# target, so a committed lock would pin every new app to the SHAs frozen at
# release time instead of resolving the tagged components. (symfony/skeleton
# does the same.) `self.version` resolves each waffle-commons/* package to the
# skeleton's own tag.
/composer.lock
